// Publicação da v2 (AMBIENTE DE TESTES) no Cloudflare — separada da produção.
// Usa o projeto de testes do Supabase. Build: npm run build:v2
{
  "name": "espelho-vendas-v2",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:v2" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://yntdnpuokozhhytdknnm.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HJobnkiShZyTZQhugEfRAg_wbf4MW9f"
  }
  // SUPABASE_SECRET_KEY do projeto de testes: cadastrar como "Secret" no painel do Cloudflare
}
