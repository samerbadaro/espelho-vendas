// Publicação no Cloudflare: servidor (worker/index.ts) + site estático (dist)
{
  "name": "espelho-vendas",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://mtlzwuiqznsyqasmdkew.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_UEbdwY_CmKxEJ_0yaGFqCA_6g52r8yb"
  }
  // SUPABASE_SECRET_KEY: cadastrar como "Secret" no painel do Cloudflare
}
